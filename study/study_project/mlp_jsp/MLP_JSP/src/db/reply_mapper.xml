<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="com.my.reply">
 	<insert id="insert">
 		INSERT INTO MLPREPLY VALUES(SEQ_MLPREPLY.NEXTVAL,#{cno},#{id},#{name},#{reply},SYSDATE)
 	</insert>
 	<select id="selectAll" resultType="ReplyDto">
 		SELECT * FROM MLPREPLY ORDER BY NO DESC
 	</select>
 	<update id="update">
 		UPDATE MLPREPLY SET REPLY=#{reply} WHERE NO=#{no}
 	</update>
 	<delete id="delete" parameterType="Integer">
 		DELETE FROM MLPREPLY WHERE NO=#{no}
 	</delete>
 </mapper>