<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
	<properties resource="db/db.properties"/>
	<typeAliases>
		<typeAlias type="com.mlp.dto.MemberDto" alias="MemberDto"/>
		<typeAlias type="com.mlp.dto.BoardDto" alias="BoardDto"/>
		<typeAlias type="com.mlp.dto.CommentDto" alias="CommentDto"/>
		<typeAlias type="com.mlp.dto.ReplyDto" alias="ReplyDto"/>
	</typeAliases>
	
	<environments default="development">
		<environment id="development">
			<transactionManager type="JDBC"/>
			<dataSource type="POOLED">
				<property name="driver" value="${driver}"/>
				<property name="url" value="${url}"></property>
				<property name="username" value="${username}"></property>
				<property name="password" value="${password}"></property>
			</dataSource>
		</environment>
	</environments>
	
	<mappers>
		<mapper resource="db/member_mapper.xml"></mapper>
		<mapper resource="db/board_mapper.xml"></mapper>
		<mapper resource="db/comment_mapper.xml"></mapper>
		<mapper resource="db/reply_mapper.xml"></mapper>
	</mappers>
</configuration>