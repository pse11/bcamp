<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="com.my.comment">
 	
 	<insert id="insert">
 		INSERT INTO MLPCOMMENT VALUES(SEQ_COMMENT.NEXTVAL,#{boardno},#{id},#{content},SYSDATE)
 	</insert>
 	
 	<select id="selectAll" resultType="CommentDto">
 		SELECT * FROM MLPCOMMENT ORDER BY NO DESC
 	</select>
 </mapper>