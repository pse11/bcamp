<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="com.my.comment">
 	
 	<insert id="insert">
 		INSERT INTO MLPCOMMENT VALUES(SEQ_COMMENT.NEXTVAL,#{boardno},#{id},#{name},#{content},SYSDATE)
 	</insert>
 	
 	<select id="selectAll" resultType="CommentDto">
 		SELECT * FROM MLPCOMMENT ORDER BY NO DESC
 	</select>
 	
 	<update id="update">
 		UPDATE MLPCOMMENT SET CONTENT=#{content} WHERE NO=#{no}
 	</update>
 	
 	<delete id="delete" parameterType="Integer">
 		DELETE FROM MLPCOMMENT WHERE NO=#{no}
 	</delete>
 </mapper>