<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mp.board">
	<select id="selectAll" resultType="BoardDto">
		SELECT * FROM COMMUNITYBOARD
	</select>
	
	<select id="selectOne" resultType="BoardDto">
		SELECT * FROM COMMUNITYBOARD WHERE NO=#{no}
	</select>
	
	<update id="update">
		UPDATE COMMUNITYBOARD SET TITLE=#{title}, CONTENT=#{content} WHERE NO=#{no}
	</update>
	
	<delete id="delete">
		DELETE FROM COMMUNITYBOARD WHERE NO=#{no}
	</delete>
	
	<insert id="insert">
		INSERT INTO COMMUNITYBOARD VALUES(SEQ_CB.NEXTVAL,#{name},#{title},#{content},SYSDATE)
	</insert>
	
	<delete id="muldel">
		DELETE FROM COMMUNITYBOARD WHERE NO IN
		<foreach collection="chks" item="no" open="(" separator="," close=")">
			#{no}
		</foreach>
	</delete>
</mapper>