<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mp.member">
	<select id="selectOne" resultType="MemberDto">
		SELECT * FROM COMMUNITYMEMBER WHERE ID=#{id}
	</select>
	
	<select id="selectOneNo" resultType="MemberDto">
		SELECT * FROM COMMUNITYMEMBER WHERE NO=#{no}
	</select>
	
	<insert id="insert">
		INSERT INTO COMMUNITYMEMBER VALUES(SEQ_CM.NEXTVAL,#{id},#{pw},#{name},#{phone},'Y')
	</insert>
	
	<update id="update">
		UPDATE COMMUNITYMEMBER SET PW=#{pw}, PHONE=#{phone} WHERE NO=#{no}
	</update>
	
	<update id="unenable">
		UPDATE COMMUNITYMEMBER SET ENABLED='N' WHERE NO=#{no}
	</update>
</mapper>