<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.my.myboard">
	<select id="selectAll" resultType="MyBoardDto"> <!-- resultType: config.xml에서 정해준 별칭을 적어준다. -->
		SELECT * FROM MYBOARD ORDER BY MYNO DESC
	</select>
	
	<!-- 컬럼의 이름과 필드명이 다른 경우 지정해줘야한다. -->
	<resultMap type="com.my.dto.MyBoardDto" id="mbMap">
		<result property="myno" column="MYNO" /> <!-- property는 setter라고 생각하기 -->
		<result property="myname" column="MYNAME"></result>
		<result property="mytitle" column="MYTITLE"></result>
		<result property="mycontent" column="MYCONTENT"></result>
		<result property="mydate" column="MYDATE"></result>
	</resultMap>
	<select id="selectOne" parameterType="int" resultMap="mbMap">
		SELECT * 
		FROM MYBOARD
		WHERE MYNO = #{myno}
	</select>
	
	<insert id="myinsert" parameterType="MyBoardDto">
		INSERT INTO MYBOARD 
		VALUES(SEQ_MYBOARD.NEXTVAL,#{myname},#{mytitle},#{mycontent},SYSDATE)
	</insert>
	
	<update id="myupdate" parameterType="MyBoardDto">
		UPDATE MYBOARD
		SET MYTITLE=#{mytitle}, MYCONTENT=#{mycontent}
		WHERE MYNO=#{myno}
	</update>
	
	<delete id="mydelete">
		DELETE FROM MYBOARD
		WHERE MYNO=#{myno}
	</delete>
	
</mapper>