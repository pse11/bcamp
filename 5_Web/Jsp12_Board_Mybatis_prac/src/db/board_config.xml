<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
  
<configuration>
	<properties resource="db/db.properties"/><!-- db.properties파일에서 DB 접속 정보를 읽어옴 -->
		<typeAliases><!-- resultType, parameterType등에 클래스 전체 이름을 써야하는데 너무 길기때문에 별칭(alias) 지어줌 -->
			<typeAlias type="com.board.dto.BoardDto" alias="BoardDto2"/>
		</typeAliases>
		
		<environments default="development"><!-- mybatis에서 db연결(환경)설정 id가 development인 환경을 default(기본)으로 사용하겠다.-->
			<environment id="development">
				<transactionManager type="JDBC"/><!-- JDBC 자체 트랜잭션을 쓰겠다. -->
				<dataSource type="POOLED"><!-- 커넥슌 풀 사용.(DB 커넥션을 매번 새로 열지 않고 미리 열어둔 걸 재사용) -->
					<property name="driver" value="${driver}"></property> <!-- properties에서 받아온 값들 -->
					<property name="url" value="${url}"></property>
					<property name="username" value="${username}"></property>
					<property name="password" value="${password}"></property>
				</dataSource>
			</environment>
		</environments>
		
		<mappers>
			<mapper resource="db/board_mapper.xml"></mapper><!-- board_mapper.xml에 SQL을 정의해놓은 것을 등록, SQL은 이 XML파일에 다 있으니까 거기서 찾아서 실행해라는 의미 -->
		</mappers>
</configuration>