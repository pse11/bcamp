<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
	http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.3.xsd">
	
	<context:component-scan base-package="com.test04.anno"/>
	
	<bean id="lee" class="com.test04.anno.Emp">
		<property name="name" value="이상은"/>
		<property name="salary" value="100000"/>
	</bean>
	
	<bean id="park" class="com.test04.anno.Emp">
		<property name="name" value="박상은"/>
		<property name="salary" value="200000"/>
	</bean>
</beans>
