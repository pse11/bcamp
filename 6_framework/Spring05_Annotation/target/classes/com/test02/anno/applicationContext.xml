<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
	http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.3.xsd">
	
	<context:annotation-config/>
	
	<bean id="lee" class="com.test02.anno.Student">
		<constructor-arg value="이창진"></constructor-arg>
		<constructor-arg value="서울시 강남구"></constructor-arg>
		<constructor-arg value="20"></constructor-arg>
	</bean>
	
	<bean id="kim" class="com.test02.anno.Student">
		<constructor-arg value="김창진"></constructor-arg>
		<constructor-arg value="서울시 강서구"></constructor-arg>
		<constructor-arg value="22"></constructor-arg>
	</bean>
	
	<bean id="mySchool" class="com.test02.anno.School"/>
</beans>
