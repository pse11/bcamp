<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:aop="http://www.springframework.org/schema/aop"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop-4.3.xsd">

	<!-- aop는 스프링이 관리하는 객체(=bean)이어야 동작한다. new로 직접 객체를 생성하면 스프링이 만든 프록시 객체가 아니기 때문에 aop가 적용되지 않는다.-->
	<!-- aspect도 bean이어야 aop가 작동 -->
	<aop:aspectj-autoproxy/>
	<bean id="myAspect" class="com.test04.AOP_anno.MyAspect"/>
	
	<!-- target -->
	<bean id="student" class="com.test04.AOP_anno.Student"/>
	<bean id="teacher" class="com.test04.AOP_anno.Teacher"/>
</beans>
