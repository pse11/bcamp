<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="student" class="com.test02.AOP.Student"/>
	<bean id="teacher" class="com.test02.AOP.Teacher"/>
	
	<!-- 공통관심사항 -->
	<bean id="myAdvice" class="com.test02.AOP.MyAspect"/> <!-- 메소드 호출시에 myAdvice로 생성된 advice가 실행되어 가로챔 -->
	
	<!-- proxy 객체 생성 -->
	<bean class="org.springframework.aop.framework.autoproxy.DefaultAdvisorAutoProxyCreator"/><!-- proxy 생성할수있도록 -->
	
	<!-- advice + pointcut -->
	<bean id="myAdvisor" class="org.springframework.aop.aspectj.AspectJExpressionPointcutAdvisor"><!-- 언제 가로채서 실행할지 표현식으로 작성 -->
		<property name="advice" ref="myAdvice"/>
		<property name="expression" value="execution(public * *(..))"/> <!-- public * *(..) 이렇게 생긴 메소드가 실행(execution)될때 myAdvice로 호출을 가로채서 실행하겠다. -> invoke실행 -> target 호출-->
													<!-- public * com.test02.AOP.Student.classWork(..) => student만 가로챔 -->
	</bean>
</beans>
