<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="myboard">
	<select id="selectList" resultType="boardDto">
		SELECT * 
		FROM MYBOARD
		ORDER BY MYNO DESC
	</select>
	
	<select id="selectOne" resultType="boardDto">
		SELECT * 
		FROM MYBOARD
		WHERE MYNO=#{myno}
	</select>
	
	<resultMap id="boardMap" type="boardDto">
		<result property="myno" column="MYNO"/>
		<result property="mynane" column="MYNAME"/>
		<result property="mytile" column="MYTITLE"/>
		<result property="mycontent" column="MYCONTENT"/>
		<result property="mydate" column="MYDATE"/>
	</resultMap>
	
	<insert id="insert" parameterType="boardDto">
		INSERT INTO MYBOARD
		VALUES(SEQ_MY.NEXTVAL, #{myname}, #{mytitle}, #{mycontent}, SYSDATE)
	</insert>
	
	<update id="update">
		UPDATE MYBOARD SET MYTITLE=#{mytitle}, MYCONTENT=#{mycontent} WHERE MYNO=#{myno}
	</update>
	
	<delete id="delete">
		DELETE FROM MYBOARD WHERE MYNO=#{myno}
	</delete>
</mapper>