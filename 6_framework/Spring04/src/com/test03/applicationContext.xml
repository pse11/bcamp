<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="favoriteFood" class="com.test03.Food">
		<property name="name" value="고기"></property>
		<property name="price" value="50000"></property>
	</bean>
	
	<bean id="unFavoriteFood" class="com.test03.Food">
		<constructor-arg value="게맛살"/>
		<constructor-arg value="5000"/>
	</bean>
	
	<bean id="myFood" class="com.test03.MyFood" autowire="byName"/>
	<!-- 
	autowire=
		byName: setter의 이름과 같은 bean을 찾아 주입
		constructor : 생성자의 parameter 타입과 같은 bean을 찾아 주입(여러개인경우 순서에 맞게 자동 주입(타입, 이름 따져서))
		byType : setter의 파라미터 타입과 같은 bean을 찾아 주입 (단, 동일한 타입의 bean이 2개이상일 경우 에러남)
		예) Spring은 Food 타입의 bean을 찾아 setFavoriteFood()로 넣어준다.
		default : 자동주입x, 기본값
	 -->
</beans>
