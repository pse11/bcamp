<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="testboard">
	<select id="selectAll" resultType="boardDto">
		SELECT * FROM TESTBOARD
	</select>
	
	<select id="selectOne" resultType="boardDto">
		SELECT * FROM TESTBOARD WHERE TESTNO=#{testno}
	</select>
	<insert id="insert" parameterType="boardDto">
		INSERT INTO TESTBOARD VALUES(SEQ_TBOARD.NEXTVAL, #{testname},#{testtitle},#{testcontent},SYSDATE)
	</insert>
</mapper>  
