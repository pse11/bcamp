<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="lee" class="com.test03.Engineer">
		<constructor-arg value="이상은"></constructor-arg>
		<constructor-arg value="2000000"></constructor-arg>
		<constructor-arg value="기술"></constructor-arg>
	</bean>
	
	<bean id="park" class="com.test03.Developer">
		<constructor-arg name="name" value="박상은"></constructor-arg>
		<constructor-arg name="salary" value="2500000"></constructor-arg>
		<property name="dept" value="개발"></property>
	</bean>
</beans>
