<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
	
	<bean id="park" class="com.test04.setter_di.Address">
		<property name="name" value="박상은"></property><!-- setter의 이름(setName)이 name에 들어간다. 매개변수의 이름과 상관없음-->
		<property name="addr" value="서울시 서초구"></property>
		<property name="phone" value="010-1111-1111"></property>
	</bean>
	
	<!-- 김창진, 경기도 하남시, 010-2222-2222 -->
	<bean id="kim" class="com.test04.setter_di.Address">
		<property name="name" value="김창진"></property>
		<property name="addr" value="경기도 하남시"></property>
		<property name="phone" value="010-2222-2222"></property>
	</bean>
	
	<!-- user01, pass01, 박상은, 010-1111-2222 -->
	<!-- 생성자를 이용하여 id, pw, name, phone값 초기화하며 빈 생성 -->
	<bean id="mpark" class="com.test04.setter_di.Member">
		<constructor-arg name="id" value="user01"></constructor-arg>
		<constructor-arg name="pw" value="pass01"></constructor-arg>
		<constructor-arg name="name" value="박상은"></constructor-arg>
		<constructor-arg name="phone" value="010-1111-2222"></constructor-arg>
	</bean>
	<!-- user02, pass02, 김상은, 010-2222-3333 -->
	<!-- setter를 이용하여 id, pw, name, phone값 초기화하며 빈 생성 -->
	<bean id="mkim" class="com.test04.setter_di.Member">
		<property name="id" value="user02"></property>
		<property name="pw" value="pass02"></property>
		<property name="name" value="김상은"></property>
		<property name="phone" value="010-2222-3333"></property>
	</bean>
	<!-- user03, pass03, 이상은, 010-3333-4444 -->
	<!-- 만들고 싶은 방법으로 빈 생성-->
	<bean id="mlee" class="com.test04.setter_di.Member">
		<constructor-arg name="id" value="user03"></constructor-arg>
		<constructor-arg name="name" value="이상은"></constructor-arg>
		<constructor-arg name="phone" value="010-3333-4444"></constructor-arg>
		<constructor-arg name="pw" value="pass03"></constructor-arg>
	</bean>
	
</beans>
